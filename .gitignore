.ipynb_checkpoints/
*-checkpoint.ipynb

# Docs build
site/
docs/_build/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# MS data — never commit raw or large derived files
*.raw
*.d/
*.wiff
*.wiff.scan
*.mzML
*.mzXML
*.mgf
*.dia
*.tdf
*.tdf_bin

# Search engine outputs that are large / regeneratable
**/combined/txt/
**/proteinGroups.txt
**/Phospho (STY)Sites.txt
**/report.tsv
*.parquet

# Study data — committed by exception only
studies/*/data/
studies/*/raw/
studies/*/output/

# Manuscript figure outputs (regeneratable)
manuscripts/*/figures/
manuscripts/*/output/

# Spectral libraries & FASTAs are pointed at, not committed
resources/spectral_libraries/*.speclib
resources/spectral_libraries/*.tsv
resources/fastas/*.fasta
