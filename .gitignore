# Search engine outputs that are large / regeneratable
**/combined/txt/
**/proteinGroups.txt
**/Phospho (STY)Sites.txt
**/report.tsv
*.parquet

# Study data — committed by exception only
studies/*/data/
studies/*/raw/
studies/*/output/

# Benchmark data — raw lab exports + regenerable derived outputs; do not commit
test_data/

# Manuscript figure outputs (regeneratable)
manuscripts/*/figures/
manuscripts/*/output/

# Spectral libraries are pointed at, not committed
resources/spectral_libraries/*.speclib
resources/spectral_libraries/*.tsv
# FASTAs (human / mouse / chinese hamster proteomes) live in
# resources/fastas/ and ARE committed -- ~37 MB total, CC-BY 4.0 from
# UniProt, needed by the FASTA-based kinase-window annotation step and
# by the walkthrough notebook.

# Design-time / benchmark validation outputs (regeneratable from the scripts
# in docs/design/ and docs/benchmark/)
docs/design/*_output/
docs/design/*_output_*/
docs/design/*_out/
docs/design/minibinder_data/
docs/design/__pycache__/
docs/benchmark/*_output/
docs/benchmark/*_output_*/
docs/benchmark/*_out/
docs/benchmark/minibinder_data/
docs/benchmark/__pycache__/
PeptideCollapse.log
**/PeptideCollapse.log

# Third-party proprietary material (Biognosys; do not redistribute)
docs/PluginPeptideCollapse.dll
docs/Spectronaut-20-Manual.pdf
